{
  "name": "lynk-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@lynk/shared && npm run build --workspace=@lynk/auth-service && npm run build --workspace=@lynk/url-service && npm run build --workspace=@lynk/redirect-service",
    "test": "npm run --workspaces --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build --workspace=@lynk/shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@neon/config": "^1.8.5",
    "@neon/env": "^1.5.2",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
