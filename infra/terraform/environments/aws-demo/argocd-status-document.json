{
  "schemaVersion": "2.2",
  "description": "Read-only verification of the expected Lynk Argo CD release",
  "parameters": {
    "ValuesRevision": {
      "type": "String",
      "allowedPattern": "^[0-9a-f]{40}$",
      "interpolationType": "ENV_VAR"
    },
    "ReleaseSha": {
      "type": "String",
      "allowedPattern": "^[0-9a-f]{40}$",
      "interpolationType": "ENV_VAR"
    },
    "UrlDigest": {
      "type": "String",
      "allowedPattern": "^sha256:[0-9a-f]{64}$",
      "interpolationType": "ENV_VAR"
    },
    "RedirectDigest": {
      "type": "String",
      "allowedPattern": "^sha256:[0-9a-f]{64}$",
      "interpolationType": "ENV_VAR"
    },
    "AuthDigest": {
      "type": "String",
      "allowedPattern": "^sha256:[0-9a-f]{64}$",
      "interpolationType": "ENV_VAR"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "readArgoStatus",
      "inputs": {
        "timeoutSeconds": "900",
        "runCommand": [
          "/opt/lynk/bin/argocd-status.sh \"$SSM_ValuesRevision\" \"$SSM_ReleaseSha\" \"$SSM_UrlDigest\" \"$SSM_RedirectDigest\" \"$SSM_AuthDigest\""
        ]
      }
    }
  ]
}
