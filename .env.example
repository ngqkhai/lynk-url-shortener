NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug
DATABASE_URL=postgres://lynk:lynk_local_only@localhost:5432/lynk_urls
PUBLIC_BASE_URL=http://localhost

# redirect-service
REDIRECT_PORT=3002
REDIRECT_DATABASE_URL=postgres://lynk:lynk_local_only@localhost:5433/lynk_redirects
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=lynk_local_only
URL_SERVICE_BASE_URL=http://localhost:3001
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_OPERATION_TIMEOUT_MS=50
UPSTREAM_TIMEOUT_MS=500

# Sprint 2 compatibility for the lightweight host-only dev setup.
# Full Sprint 3A auth + Kafka is enabled by make k8s-local-deploy / make test-sprint3a.
AUTH_REQUIRED=false
URL_EVENTS_ENABLED=false
# When AUTH_REQUIRED=true, point JWT_PUBLIC_KEY_PATH at a provisioned public key.
# JWT_PUBLIC_KEY_PATH=/tmp/lynk-keys/jwt-public.pem
# KAFKA_BROKERS=localhost:9092
